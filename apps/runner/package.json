{
  "name": "@rosterdesk/runner",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "roster-desk": "./dist/cli.js"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup",
    "start": "tsx src/cli.ts start",
    "desktop": "tsx src/cli.ts start --ui",
    "dev": "tsx watch src/cli.ts start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "doctor": "tsx src/cli.ts doctor",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "@rosterdesk/agent-kit": "workspace:^",
    "@rosterdesk/protocol": "workspace:^",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.1",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.0.9"
  }
}
